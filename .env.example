APP_NAME="Mikausis — vecāku aptaujas"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Public application source repository (HTTPS); empty hides the source link.
APP_SOURCE_URL=https://github.com/logingrupa/mikausis-parent-surveys
APP_LOCALE=lv
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=lv_LV
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning
DB_CONNECTION=sqlite
# Production: absolute shared path outside release directories.
# DB_DATABASE=/home/forge/aptaujas.mikausis.lv/shared/database.sqlite
DB_FOREIGN_KEYS=true
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Enable on production HTTPS:
# SESSION_SECURE_COOKIE=true
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
MAIL_MAILER=log
MAIL_FROM_ADDRESS="mikausis@mikausis.lv"
MAIL_FROM_NAME="${APP_NAME}"
